#lang racket/base
(require racket/runtime-path
         racket/list)

;; Generates "compile/shareable-primitive.rkt" from annotations in
;; "../cs/primitive/*.ss". Run this script manually after changing
;; a `shareable...` annotation there:
;;
;;   racket gen-shareable-primitive.rkt
;;
;; An entry in a `define-primitive-table` form can have a tag after
;; its known-value description:
;;
;;   shareable - calling the primitive has no side effect other than
;;      raising an exception, does not call procedure arguments or
;;      other user code (e.g., no `equal?`-based hashing), and does
;;      not return a newly allocated mutable value; when the primitive
;;      is also described as `known-procedure/no-return`, it is treated
;;      as an exception-raising function, so arguments to a call can
;;      use `shareable-for-error` primitives
;;
;;   (shareable n ...) - like `shareable`, but only when called with
;;      one of the given numbers of arguments; for example, a parameter
;;      that is shareable to read has `(shareable 0)`
;;
;;   shareable-for-error - like `shareable`, but may allocate a new
;;      mutable value, so a call is allowed only to compute an argument
;;      for an exception-raising call
;;
;;   shareable-property - a structure-type property whose guard (if
;;      any) satisfies the constraints of `shareable`
;;
;;   unshareable - overrides the default for a `...folding...` entry
;;
;; An entry without a tag is treated as `shareable` if its known-value
;; description is a `...folding...` variant, since such a primitive
;; must be free of side effects and produce an immutable result.
;;
;; See "compile/shareable.rkt" for how the information is used.

(define-runtime-path primitive-dir "../cs/primitive")
(define-runtime-path out-file "compile/shareable-primitive.rkt")

(define folding-knowns
  '(known-procedure/folding
    known-procedure/folding/limited
    known-procedure/pure/folding
    known-procedure/has-unsafe/folding
    known-procedure/has-unsafe/folding/limited))

(define shareable null)
(define arity-shareable null) ; list of (cons sym (list n ...))
(define raising null)
(define for-error null)
(define properties null)

(for ([f (in-list (sort (directory-list primitive-dir) path<?))]
      #:when (regexp-match? #rx"[.]ss$" f))
  (define forms
    (call-with-input-file* (build-path primitive-dir f)
      (lambda (in)
        (let loop ()
          (define v (read in))
          (if (eof-object? v) null (cons v (loop)))))))
  (for ([form (in-list forms)]
        #:when (and (pair? form) (eq? (car form) 'define-primitive-table)))
    (for ([entry (in-list (cddr form))])
      (define (bad why)
        (error 'gen-shareable-primitive "~a in ~a: ~s" why f entry))
      (unless (and (list? entry) (>= (length entry) 2) (symbol? (car entry)))
        (bad "unrecognized entry"))
      (define prim (car entry))
      (define known (cadr entry))
      (define known-kind (and (pair? known) (car known)))
      (define tag
        (cond
          [(null? (cddr entry))
           (and (memq known-kind folding-knowns) 'shareable)]
          [(pair? (cdddr entry)) (bad "too many tags")]
          [else (caddr entry)]))
      (cond
        [(not tag) (void)]
        [(eq? tag 'shareable)
         (set! shareable (cons prim shareable))
         (when (eq? known-kind 'known-procedure/no-return)
           (set! raising (cons prim raising)))]
        [(and (pair? tag)
              (eq? (car tag) 'shareable)
              (list? tag)
              (andmap exact-nonnegative-integer? (cdr tag)))
         (set! arity-shareable (cons (cons prim (cdr tag)) arity-shareable))]
        [(eq? tag 'shareable-for-error)
         (set! for-error (cons prim for-error))]
        [(eq? tag 'shareable-property)
         (set! properties (cons prim properties))]
        [(eq? tag 'unshareable) (void)]
        [else (bad "bad tag")]))))

(define (sorted l)
  (sort (remove-duplicates l eq?) symbol<?))

(define (print-list name l o)
  (fprintf o "\n(define ~a\n  '(" name)
  (let loop ([l l] [col 4] [first? #t])
    (unless (null? l)
      (define s (format "~s" (car l)))
      (cond
        [first? (write-string s o) (loop (cdr l) (+ col (string-length s)) #f)]
        [(> (+ col 1 (string-length s)) 72)
         (fprintf o "\n    ~a" s)
         (loop (cdr l) (+ 4 (string-length s)) #f)]
        [else
         (fprintf o " ~a" s)
         (loop (cdr l) (+ col 1 (string-length s)) #f)])))
  (fprintf o "))\n"))

(call-with-output-file* out-file
  #:exists 'truncate
  (lambda (o)
    (fprintf o "#lang racket/base\n")
    (fprintf o ";; Generated by \"../gen-shareable-primitive.rkt\" from\n")
    (fprintf o ";; `shareable...` annotations in \"../../cs/primitive/*.ss\".\n")
    (fprintf o ";; DO NOT EDIT; change the annotations and run the script.\n")
    (fprintf o "\n(provide shareable-primitives\n")
    (fprintf o "         shareable-arity-primitives\n")
    (fprintf o "         shareable-raising-primitives\n")
    (fprintf o "         shareable-for-error-primitives\n")
    (fprintf o "         shareable-properties)\n")
    (print-list 'shareable-primitives (sorted shareable) o)
    (fprintf o "\n;; Each element is `(cons <sym> (list <arg-count> ...))`:")
    (print-list 'shareable-arity-primitives
                (sort (remove-duplicates arity-shareable) symbol<? #:key car)
                o)
    (print-list 'shareable-raising-primitives (sorted raising) o)
    (print-list 'shareable-for-error-primitives (sorted for-error) o)
    (print-list 'shareable-properties (sorted properties) o)))
