#lang zuo/kernel

;; Implements a less minimal language by adding `and`, `or`, `cond`, and `quasiauote`.
;; These will be replaced with variants that cooerate better with bindings after
;; the defmacro layer, but implementing the defmacro layer is a path without these.

(hash 'read-and-eval
      (lambda (str start)
        (let ([es (read-from-string-all (substring str start (string-length str)))])
          (letrec ([convert (lambda (s)
                              (if (pair? s)
                                  (if (eq? (car s) 'or)
                                      (letrec ([expand-or (lambda (l)
                                                            (if (null? l)
                                                                #f
                                                                (if (pair? l)
                                                                    (if (null? (cdr l))
                                                                        (convert (car l))
                                                                        (let ([tmp (string->uninterned-symbol "ortmp")])
                                                                          (list 'let
                                                                                (list (list tmp
                                                                                            (convert (car l))))
                                                                                (list 'if
                                                                                      tmp
                                                                                      tmp
                                                                                      (expand-or (cdr l))))))
                                                                    (error "or: bad syntax" s))))])
                                        (expand-or (cdr s)))
                                      (if (eq? (car s) 'and)
                                          (letrec ([expand-and (lambda (l)
                                                                 (if (null? l)
                                                                     #t
                                                                     (if (pair? l)
                                                                         (if (null? (cdr l))
                                                                             (convert (car l))
                                                                             (list 'if
                                                                                   (convert (car l))
                                                                                   (expand-and (cdr l))
                                                                                   #f))
                                                                         (error "and: bad syntax" s))))])
                                            (expand-and (cdr s)))
                                          (if (eq? (car s) 'cond)
                                              (let ([no (lambda () (error "cond: bad syntax" s))])
                                                (let ([maybe-begin (lambda (l)
                                                                     (if (null? (cdr l))
                                                                         (car l)
                                                                         (cons 'begin l)))])
                                                  (letrec ([expand-cond (lambda (l)
                                                                          (if (null? l)
                                                                              (void)
                                                                              (if (pair? l)
                                                                                  (if (list? (car l))
                                                                                      (if (>= (length (car l)) 2)
                                                                                          (if (eq? (car (car l)) 'else)
                                                                                              (if (null? (cdr l))
                                                                                                  (convert (maybe-begin (cdr (car l))))
                                                                                                  (no))
                                                                                              (list 'if
                                                                                                    (car (car l))
                                                                                                    (convert (maybe-begin (cdr (car l))))
                                                                                                    (expand-cond (cdr l))))
                                                                                          (no))
                                                                                      (no))
                                                                                  (no))))])
                                                    (expand-cond (cdr s)))))
                                              (if (eq? (car s) 'quasiquote)
                                                  (letrec ([expand-quasiquote (lambda (l)
                                                                                (if (null? l)
                                                                                    '()
                                                                                    (if (pair? l)
                                                                                        (if (eq? (car l) 'unquote)
                                                                                            (if (= 2 (length l))
                                                                                                (convert (car (cdr l)))
                                                                                                (error "unquote: bad syntax" l))
                                                                                            (list 'cons
                                                                                                  (expand-quasiquote (car l))
                                                                                                  (expand-quasiquote (cdr l))))
                                                                                        (if (symbol? l)
                                                                                            (list 'quote l)
                                                                                            l))))])
                                                    (if (= 2 (length s))
                                                        (expand-quasiquote (car (cdr s)))
                                                        (error "quasiquote: bad syntax" s)))
                                                  (if (eq? (car s) 'quote)
                                                      s
                                                      (cons (convert (car s))
                                                            (convert (cdr s))))))))
                                  (if (eq? s 'eval) ; this is how we make our `eval` work at the next layer
                                      (lambda (e) (eval (convert e)))
                                      s)))])
            (let ([es (convert es)])
              (letrec ([eval-all (lambda (es)
                                   (if (null? es)
                                       (hash)
                                       (if (null? (cdr es))
                                           (car es)
                                           (begin
                                             (eval (car es))
                                             (eval-all (cdr es))))))])
                (eval-all es)))))))
